# Copy to backend/.env for local API/worker (N3). File is gitignored — never commit keys.
# Docker compose (api/worker) loads this via env_file (optional). Do not put secrets in
# infra/docker-compose.yml. Compose still overrides DATABASE_URL/REDIS_URL for the docker network.

ENV=dev
DATABASE_URL=postgresql+asyncpg://dictably:dictably@127.0.0.1:55432/dictably
TEST_DATABASE_URL=postgresql+asyncpg://dictably:dictably@127.0.0.1:55432/dictably_test
REDIS_URL=redis://127.0.0.1:56379/0

ASR_PROVIDER=fake
# ASR_FALLBACK=assemblyai
# ASSEMBLYAI_API_KEY=
# TRIAL_SECONDS=10800  # MVP-0: 3h per user
LLM_PROVIDER=fake
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
# INLINE_MEDIA_PROCESS=1  # process after upload without arq worker (local/e2e)

# T-011: only when ENV=dev (or test). Never enable in prod.
DEV_LOGIN=1
# Promote admin (never via UI): uv run python -m dictably.cli set-admin you@example.com

SESSION_TTL_DAYS=30
# Cookie Secure: default on when ENV=prod; set 0 for http://localhost via nginx/proxy tests
# COOKIE_SECURE=0
PUBLIC_APP_URL=http://127.0.0.1:3000
# Rightmost X-Forwarded-For hops that are trusted proxies (nginx=1; Railway edge+nginx=2).
# Default 0 = use TCP peer only (ignore client-supplied XFF).
TRUSTED_PROXY_HOPS=0

# Google OAuth (optional locally — use Dev login). Required in prod.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

LOG_LEVEL=INFO

# Paid providers — leave empty for MVP-0 local/CI
# ASSEMBLYAI_API_KEY=
# ANTHROPIC_API_KEY=
