# Copy to backend/.env for local API/worker (N3).
# Compose services use their own environment: block in infra/docker-compose.yml.

ENV=dev
DATABASE_URL=postgresql+asyncpg://dictably:dictably@127.0.0.1:55432/dictably
TEST_DATABASE_URL=postgresql+asyncpg://dictably:dictably@127.0.0.1:55432/dictably_test
REDIS_URL=redis://127.0.0.1:56379/0

ASR_PROVIDER=fake
LLM_PROVIDER=fake
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage

# T-011: only when ENV=dev
DEV_LOGIN=1

LOG_LEVEL=INFO

# Paid providers — leave empty for MVP-0 local/CI
# ASSEMBLYAI_API_KEY=
# ANTHROPIC_API_KEY=
