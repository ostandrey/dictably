# Copy to .env.local for local builds, or set as Railway Docker build args.
# Production builds fail without the required vars (scripts/check-env.mjs).
# Preview (T-023a): NEXT_PUBLIC_SITE_MODE=preview → only SITE_URL required.
# Local/e2e only: DICTABLY_ALLOW_PLACEHOLDER_ENV=1

NEXT_PUBLIC_SITE_URL=
# preview | production (default production)
NEXT_PUBLIC_SITE_MODE=production
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CF_BEACON=
# Design (T-004): site-wide accent + theme. Defaults: teal + light.
# NEXT_PUBLIC_ACCENT=teal|tomato
# NEXT_PUBLIC_THEME=light|dark|system
# Privacy "Last updated" is fixed in src/lib/site.ts → privacyUpdated
