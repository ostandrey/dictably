FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Required at build — no placeholders in production image
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_CONTROLLER_NAME
ARG NEXT_PUBLIC_TALLY_FORM_EN
ARG NEXT_PUBLIC_TALLY_FORM_UK
ARG NEXT_PUBLIC_CF_BEACON=
ARG NEXT_PUBLIC_PRIVACY_UPDATED=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL \
    NEXT_PUBLIC_CONTROLLER_NAME=$NEXT_PUBLIC_CONTROLLER_NAME \
    NEXT_PUBLIC_TALLY_FORM_EN=$NEXT_PUBLIC_TALLY_FORM_EN \
    NEXT_PUBLIC_TALLY_FORM_UK=$NEXT_PUBLIC_TALLY_FORM_UK \
    NEXT_PUBLIC_CF_BEACON=$NEXT_PUBLIC_CF_BEACON \
    NEXT_PUBLIC_PRIVACY_UPDATED=$NEXT_PUBLIC_PRIVACY_UPDATED
RUN node scripts/check-env.mjs && pnpm build

FROM nginx:1.27-alpine
ENV PORT=80
COPY --from=build /app/out /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
